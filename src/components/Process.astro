---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

type IndexData = Extract<CollectionEntry<'pages'>['data'], { page: 'index' }>;

interface Props {
  process: IndexData['process'];
}

const { process } = Astro.props;
---

<section id="ablauf" data-cms-section="process" class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={process.eyebrow}
      title={process.title}
      subtitle={process.subtitle}
      fieldPrefix="index.process"
    />
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        process.steps.map((step, i) => (
          <li class="relative" data-animate data-animate-delay={String(i * 130)}>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary font-heading text-xl font-extrabold text-ink shadow-lg shadow-primary/30">
              {String(i + 1).padStart(2, '0')}
            </div>
            {i < process.steps.length - 1 && (
              <div
                class="absolute left-16 top-7 hidden h-0.5 w-[calc(100%-4rem)] bg-gradient-to-r from-primary/50 to-transparent md:block"
                aria-hidden="true"
              />
            )}
            <h3 data-cms-field={`index.process.steps.${i}.title`} class="mt-5 text-xl">
              {step.title}
            </h3>
            <p data-cms-field={`index.process.steps.${i}.text`} class="mt-3 leading-relaxed text-muted">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

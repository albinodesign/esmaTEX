---
import type { CollectionEntry } from 'astro:content';
import CheckIcon from './icons/CheckIcon.astro';

type IndexData = Extract<CollectionEntry<'pages'>['data'], { page: 'index' }>;

interface Props {
  form: IndexData['form'];
}

const { form } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const inputClass =
  'mt-1.5 w-full rounded-xl border border-slate-300 bg-surface px-4 py-3 text-ink placeholder:text-slate-500 transition focus:border-primary-dark focus:outline-none focus:ring-2 focus:ring-primary/40';
const labelClass = 'block text-sm font-semibold text-ink';
---

<div class="rounded-3xl bg-surface p-7 shadow-xl ring-1 ring-slate-200 sm:p-9">
  <h2 data-cms-field="index.form.title" class="text-2xl">{form.title}</h2>
  <p data-cms-field="index.form.subtitle" class="mt-2 text-muted">{form.subtitle}</p>

  <div id="form-success" hidden class="mt-7 rounded-2xl bg-primary/10 p-7 text-center" role="status">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary text-ink">
      <CheckIcon class="h-6 w-6" />
    </span>
    <h3 data-cms-field="index.form.successtitle" class="mt-4 text-xl">{form.successTitle}</h3>
    <p data-cms-field="index.form.successmessage" class="mt-2 text-muted">{form.successMessage}</p>
  </div>

  <form
    id="contact-form"
    class="mt-7 space-y-5"
    novalidate
    data-submit-label={form.submitLabel}
    data-error-message={form.errorMessage}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={form.emailSubject} />
    <input
      type="checkbox"
      name="botcheck"
      style="display: none;"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="firstName" class={labelClass}>
          <span data-cms-field="index.form.firstnamelabel">{form.firstNameLabel}</span>
          <span class="text-primary-dark" aria-hidden="true"> *</span>
        </label>
        <input
          id="firstName"
          name="firstName"
          type="text"
          required
          autocomplete="given-name"
          placeholder={form.firstNamePlaceholder}
          class={inputClass}
        />
      </div>
      <div>
        <label for="lastName" class={labelClass}>
          <span data-cms-field="index.form.lastnamelabel">{form.lastNameLabel}</span>
          <span class="text-primary-dark" aria-hidden="true"> *</span>
        </label>
        <input
          id="lastName"
          name="lastName"
          type="text"
          required
          autocomplete="family-name"
          placeholder={form.lastNamePlaceholder}
          class={inputClass}
        />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="email" class={labelClass}>
          <span data-cms-field="index.form.emaillabel">{form.emailLabel}</span>
          <span class="text-primary-dark" aria-hidden="true"> *</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={form.emailPlaceholder}
          class={inputClass}
        />
      </div>
      <div>
        <label for="phone" class={labelClass} data-cms-field="index.form.phonelabel">{form.phoneLabel}</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder={form.phonePlaceholder}
          class={inputClass}
        />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="service" class={labelClass}>
          <span data-cms-field="index.form.servicelabel">{form.serviceLabel}</span>
          <span class="text-primary-dark" aria-hidden="true"> *</span>
        </label>
        <select id="service" name="service" required class={inputClass}>
          <option value="" disabled selected data-cms-field="index.form.serviceplaceholder">
            {form.servicePlaceholder}
          </option>
          {form.serviceOptions.map((option, i) => (
            <option value={option} data-cms-field={`index.form.serviceoptions.${i}`}>{option}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="quantity" class={labelClass} data-cms-field="index.form.quantitylabel">
          {form.quantityLabel}
        </label>
        <input
          id="quantity"
          name="quantity"
          type="number"
          min="1"
          inputmode="numeric"
          placeholder={form.quantityPlaceholder}
          class={inputClass}
        />
      </div>
    </div>

    <div>
      <label for="message" class={labelClass}>
        <span data-cms-field="index.form.messagelabel">{form.messageLabel}</span>
        <span class="text-primary-dark" aria-hidden="true"> *</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder={form.messagePlaceholder}
        class={inputClass}></textarea>
    </div>

    <p class="text-xs leading-relaxed text-muted">
      {form.privacyNote}{' '}
      <a
        href="/datenschutz"
        data-cms-field="form.privacylinklabel"
        class="font-medium text-primary-dark underline underline-offset-2 transition hover:text-ink"
      >
        {form.privacyLinkLabel}
      </a>
    </p>

    <p
      id="form-status"
      role="alert"
      hidden
      class="rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-800"
    >
    </p>

    <button
      type="submit"
      data-cms-field="index.form.submitlabel"
      class="w-full rounded-xl bg-primary px-6 py-3.5 font-semibold text-ink shadow-lg shadow-primary/30 transition hover:bg-primary-dark hover:text-white disabled:cursor-not-allowed disabled:opacity-60"
    >
      {form.submitLabel}
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const status = document.getElementById('form-status');
    const success = document.getElementById('form-success');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.dataset.submitLabel ?? '';

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = `${submitLabel} …`;
    }
    if (status) {
      status.hidden = true;
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form)
      });
      const result = (await response.json()) as { success?: boolean };

      if (response.ok && result.success) {
        form.classList.add('hidden');
        if (success) {
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else {
        throw new Error('Web3Forms submission failed');
      }
    } catch {
      if (status) {
        status.textContent = form.dataset.errorMessage ?? '';
        status.hidden = false;
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
      }
    }
  });
</script>

---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import UsersIcon from './icons/UsersIcon.astro';
import MapPinIcon from './icons/MapPinIcon.astro';
import PhoneIcon from './icons/PhoneIcon.astro';
import MailIcon from './icons/MailIcon.astro';
import ClockIcon from './icons/ClockIcon.astro';
import TruckIcon from './icons/TruckIcon.astro';

type IndexData = Extract<CollectionEntry<'pages'>['data'], { page: 'index' }>;

interface Props {
  contact: IndexData['contact'];
  form: IndexData['form'];
  site: CollectionEntry<'site'>['data'];
}

const { contact, form, site } = Astro.props;

const infoItems = [
  { icon: MapPinIcon, label: contact.info.addressLabel, labelField: 'index.contact.info.addresslabel' },
  { icon: PhoneIcon, label: contact.info.phoneLabel, labelField: 'index.contact.info.phonelabel' },
  { icon: MailIcon, label: contact.info.emailLabel, labelField: 'index.contact.info.emaillabel' },
  { icon: ClockIcon, label: contact.info.hoursLabel, labelField: 'index.contact.info.hourslabel' }
];
---

<section id="kontakt" data-cms-section="contact" class="bg-subtle py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={contact.eyebrow}
      title={contact.title}
      subtitle={contact.subtitle}
      fieldPrefix="index.contact"
    />
    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-10">
      <div data-cms-section="contact-info" data-animate>
        <h2 data-cms-field="index.contact.info.title" class="text-2xl">{contact.info.title}</h2>
        <p data-cms-field="index.contact.info.text" class="mt-3 leading-relaxed text-muted">
          {contact.info.text}
        </p>

        <div class="mt-6 flex items-center gap-4 rounded-2xl bg-surface p-5 ring-1 ring-slate-200">
          <span
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary text-ink"
          >
            <UsersIcon class="h-7 w-7" />
          </span>
          <div>
            <p
              data-cms-field="index.contact.info.personname"
              class="font-heading text-lg font-bold text-ink"
            >
              {contact.info.personName}
            </p>
            <p data-cms-field="index.contact.info.personrole" class="text-sm text-muted">
              {contact.info.personRole}
            </p>
          </div>
        </div>

        <ul class="mt-8 space-y-6">
          {
            infoItems.map((item) => (
              <li class="flex items-start gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary-dark">
                  <item.icon class="h-5 w-5" />
                </span>
                <div>
                  <p data-cms-field={item.labelField} class="text-sm font-semibold text-ink">
                    {item.label}
                  </p>
                  {item.labelField === 'index.contact.info.addresslabel' && (
                    <p class="mt-1 text-muted">
                      <span data-cms-field="address.street">{site.address.street}</span>
                      <br />
                      <span data-cms-field="address.zip">{site.address.zip}</span>{' '}
                      <span data-cms-field="address.city">{site.address.city}</span>
                    </p>
                  )}
                  {item.labelField === 'index.contact.info.phonelabel' && (
                    <a
                      href={site.phone.href}
                      class="mt-1 inline-block font-medium text-primary-dark transition hover:text-ink"
                    >
                      <span data-cms-field="phone.display">{site.phone.display}</span>
                    </a>
                  )}
                  {item.labelField === 'index.contact.info.emaillabel' && (
                    <a
                      href={`mailto:${site.email}`}
                      class="mt-1 inline-block font-medium text-primary-dark transition hover:text-ink"
                    >
                      <span data-cms-field="email">{site.email}</span>
                    </a>
                  )}
                  {item.labelField === 'index.contact.info.hourslabel' && (
                    <div class="mt-1 text-muted">
                      <ul class="space-y-1">
                        {site.openingHours.map((entry, i) => (
                          <li>
                            <span data-cms-field={`openinghours.${i}.days`}>{entry.days}</span>:{' '}
                            <span data-cms-field={`openinghours.${i}.hours`}>{entry.hours}</span>
                          </li>
                        ))}
                      </ul>
                      <p data-cms-field="index.contact.info.hoursnote" class="mt-2 text-sm">
                        {contact.info.hoursNote}
                      </p>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 rounded-2xl bg-ink p-6 text-slate-300">
          <div class="flex items-center gap-3">
            <TruckIcon class="h-6 w-6 shrink-0 text-primary" />
            <h3 data-cms-field="index.contact.anfahrt.title" class="text-lg text-white">
              {contact.anfahrt.title}
            </h3>
          </div>
          <p data-cms-field="index.contact.anfahrt.text" class="mt-3 text-sm leading-relaxed">
            {contact.anfahrt.text}
          </p>
        </div>
      </div>

      <div data-cms-section="contact-form" data-animate data-animate-delay="120">
        <ContactForm form={form} />
      </div>
    </div>
  </div>
</section>

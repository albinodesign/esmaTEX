---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pageEntry = await getEntry('pages', 'impressum');
if (!pageEntry || pageEntry.data.page !== 'impressum') {
  throw new Error('Seiteninhalte für das Impressum fehlen (src/content/pages/impressum.json).');
}
const page = pageEntry.data;

const siteEntry = await getEntry('site', 'site');
if (!siteEntry) {
  throw new Error('Zentrale Unternehmensdaten fehlen.');
}
const site = siteEntry.data;
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  cmsTitleField="impressum.meta.title"
  cmsDescriptionField="impressum.meta.description"
>
  <section data-cms-section="impressum-header" class="bg-subtle py-14 lg:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6" data-animate>
      <h1 data-cms-field="impressum.header.title" class="text-4xl font-extrabold sm:text-5xl">
        {page.header.title}
      </h1>
      <p data-cms-field="impressum.header.subtitle" class="mt-3 text-lg text-muted">
        {page.header.subtitle}
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-16">
    <div class="mx-auto max-w-3xl space-y-12 px-4 sm:px-6">
      <div
        data-cms-section="impressum-company"
        class="rounded-3xl bg-subtle p-7 ring-1 ring-slate-200 sm:p-9"
        data-animate
      >
        <h2 data-cms-field="impressum.companysection.title" class="text-2xl">
          {page.companySection.title}
        </h2>
        <address class="mt-4 leading-relaxed text-ink not-italic">
          <strong data-cms-field="name">{site.name}</strong> · <span data-cms-field="legalform">{site.legalForm}</span><br />
          <span data-cms-field="owner">{site.owner}</span><br />
          <span data-cms-field="address.street">{site.address.street}</span><br />
          <span data-cms-field="address.zip">{site.address.zip}</span>
          <span data-cms-field="address.city">{site.address.city}</span><br />
          {site.address.countryName}
        </address>
        <p class="mt-4 text-ink">
          <span data-cms-field="impressum.companysection.phonelabel">{page.companySection.phoneLabel}</span>:
          <a href={site.phone.href} class="font-medium text-primary-dark transition hover:text-ink">
            <span data-cms-field="phone.display">{site.phone.display}</span>
          </a>
          <br />
          <span data-cms-field="impressum.companysection.emaillabel">{page.companySection.emailLabel}</span>:
          <a
            href={`mailto:${site.email}`}
            class="font-medium text-primary-dark transition hover:text-ink"
          >
            <span data-cms-field="email">{site.email}</span>
          </a>
        </p>
        <p class="mt-5 text-sm text-muted">
          <span data-cms-field="impressum.companysection.vatlabel">{page.companySection.vatLabel}</span><br />
          <span data-cms-field="vatid" class="font-semibold text-ink">{site.vatId}</span>
        </p>
        <p class="mt-5 text-sm text-muted">
          <span data-cms-field="impressum.companysection.responsibletitle" class="font-semibold text-ink"
            >{page.companySection.responsibleTitle}</span
          ><br />
          {site.owner}, {site.address.street}, {site.address.zip}
          {site.address.city}
        </p>
      </div>

      {
        page.sections.map((section, i) => (
          <div data-animate>
            <h2 data-cms-field={`impressum.sections.${i}.title`} class="text-2xl">
              {section.title}
            </h2>
            {section.paragraphs.map((paragraph, j) => (
              <p
                data-cms-field={`impressum.sections.${i}.paragraphs.${j}`}
                class="mt-3 leading-relaxed text-muted"
              >
                {paragraph}
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</Layout>

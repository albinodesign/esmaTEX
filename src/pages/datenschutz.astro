---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pageEntry = await getEntry('pages', 'datenschutz');
if (!pageEntry || pageEntry.data.page !== 'datenschutz') {
  throw new Error('Seiteninhalte für den Datenschutz fehlen (src/content/pages/datenschutz.json).');
}
const page = pageEntry.data;

const siteEntry = await getEntry('site', 'site');
if (!siteEntry) {
  throw new Error('Zentrale Unternehmensdaten fehlen.');
}
const site = siteEntry.data;
---

<Layout title={page.meta.title} description={page.meta.description}>
  <section data-cms-section="datenschutz-header" class="bg-subtle py-14 lg:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6" data-animate>
      <h1 data-cms-field="header.title" class="text-4xl font-extrabold sm:text-5xl">
        {page.header.title}
      </h1>
      <p data-cms-field="header.subtitle" class="mt-3 text-lg text-muted">
        {page.header.subtitle}
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-16">
    <div class="mx-auto max-w-3xl space-y-12 px-4 sm:px-6">
      <div data-cms-section="datenschutz-controller" data-animate>
        <h2 data-cms-field="controllerSection.title" class="text-2xl">
          {page.controllerSection.title}
        </h2>
        <p data-cms-field="controllerSection.text" class="mt-3 leading-relaxed text-muted">
          {page.controllerSection.text}
        </p>
        <address class="mt-4 rounded-2xl bg-subtle p-6 leading-relaxed text-ink ring-1 ring-slate-200 not-italic">
          <strong data-cms-field="name">{site.name}</strong> · <span data-cms-field="legalForm">{site.legalForm}</span><br />
          <span data-cms-field="owner">{site.owner}</span><br />
          <span data-cms-field="address.street">{site.address.street}</span><br />
          <span data-cms-field="address.zip">{site.address.zip}</span>
          <span data-cms-field="address.city">{site.address.city}</span><br />
          <span data-cms-field="controllerSection.phoneLabel">{page.controllerSection.phoneLabel}</span>:
          <a href={site.phone.href} class="font-medium text-primary-dark transition hover:text-ink">
            <span data-cms-field="phone.display">{site.phone.display}</span>
          </a>
          <br />
          <span data-cms-field="controllerSection.emailLabel">{page.controllerSection.emailLabel}</span>:
          <a
            href={`mailto:${site.email}`}
            class="font-medium text-primary-dark transition hover:text-ink"
          >
            <span data-cms-field="email">{site.email}</span>
          </a>
        </address>
      </div>

      {
        page.sections.map((section, i) => (
          <div data-animate>
            <h2 data-cms-field={`sections.${i}.title`} class="text-2xl">
              {section.title}
            </h2>
            {section.paragraphs.map((paragraph, j) => (
              <p
                data-cms-field={`sections.${i}.paragraphs.${j}`}
                class="mt-3 leading-relaxed text-muted"
              >
                {paragraph}
              </p>
            ))}
            {section.list && (
              <ul class="mt-3 list-disc space-y-1.5 pl-6 text-muted">
                {section.list.map((item, j) => (
                  <li data-cms-field={`sections.${i}.list.${j}`}>{item}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
